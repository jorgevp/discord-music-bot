# Copy to .env and adjust. Every value is optional; the web dashboard can configure everything.

# Where the dashboard is published on the host.
WEB_PORT=8080
# Use 127.0.0.1 to only allow access from this machine.
WEB_BIND=0.0.0.0

# Initial dashboard password (min. 8 characters). If empty, you create one on first visit.
ADMIN_PASSWORD=

# Pre-fill settings on first start (can be changed in the dashboard later).
DISCORD_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# The URL you use to open the dashboard. Used for the Spotify sign-in redirect.
# Spotify only accepts https:// URLs or http://127.0.0.1 (not "localhost").
PUBLIC_URL=http://127.0.0.1:8080

# Set to 1 (or true) when running behind a reverse proxy that terminates HTTPS.
TRUST_PROXY=

LOG_LEVEL=info
TZ=UTC
