{
  "name": "discord-music-bot",
  "version": "1.0.0",
  "description": "Self-hosted Discord music bot with a web dashboard. Plays YouTube, Spotify, SoundCloud and anything else yt-dlp supports.",
  "type": "module",
  "main": "src/index.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node src/index.js",
    "check": "node --check src/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "express": "^5.3.0",
    "opusscript": "^0.1.1",
    "socket.io": "^4.8.4"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0"
  },
  "allowScripts": {
    "@discordjs/opus@0.10.0": true
  }
}
